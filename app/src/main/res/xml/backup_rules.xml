<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup Rules: Exclude ALL app data from backups.
    No model files, no cache, no user selections should be backed up.
    This reinforces the privacy-first design.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database"   path="." />
    <exclude domain="file"       path="." />
    <exclude domain="external"   path="." />
</full-backup-content>
